---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "../../../layouts/Base.astro";
import Tag from "../../../templates/tag.tsx";
import { getAllPosts, getPublishedPosts, inFileOrder } from "../../../utils/posts";

export const getStaticPaths = (async () => {
    const tags = [...new Set((await getAllPosts()).flatMap((post) => post.fields.tags))];
    const published = await getPublishedPosts();

    return tags.map((tag) => ({
        params: { tag },
        props: { tag, posts: published.filter((post) => post.fields.tags.includes(tag)).sort(inFileOrder) },
    }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;
---

<Base title={`Posts in tag "${tag}"`}>
    <Tag tag={tag} posts={posts} />
</Base>
